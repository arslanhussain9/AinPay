datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Freelancer {
  id             String        @id @default(cuid())
  username       String        @unique // e.g. "arslan" -> /pay/arslan
  name           String        // e.g. "Arslan Ahmad"
  email          String        @unique
  mobile         String?
  vpa            String        // UPI ID e.g. "arslan@okhdfcbank"
  title          String?       // e.g. "Fullstack Developer & UI Designer"
  bio            String?       // e.g. "Building clean web apps & micro-SaaS. Available for freelance projects."
  avatarUrl      String?
  twitter        String?
  github         String?
  linkedin       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  paymentLinks   PaymentLink[]
  payments       Payment[]

  @@index([username])
}

model PaymentLink {
  id             String       @id @default(cuid())
  freelancerId   String
  freelancer     Freelancer   @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  title          String       // e.g. "Website Design Advance", "1-Hour Tech Consultation"
  slug           String       // e.g. "website-advance"
  description    String?
  
  // Stored strictly in integer paise (₹2,000.00 = 200000)
  amountPaise    Int?         // null means custom / open amount
  isFixedAmount  Boolean      @default(true)
  
  maxSlots       Int?         // e.g. 5 consultation slots
  usedSlots      Int          @default(0)
  
  status         String       @default("ACTIVE") // ACTIVE, PAUSED, CLOSED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  payments       Payment[]

  @@unique([freelancerId, slug])
  @@index([freelancerId, status])
}

model Payment {
  id             String       @id @default(cuid())
  freelancerId   String
  freelancer     Freelancer   @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  paymentLinkId  String?
  paymentLink    PaymentLink? @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)

  payerName      String       // Client Name e.g. "Rahul Sharma"
  payerEmail     String?
  payerPhone     String?
  amountPaise    Int          // in paise
  utrNumber      String       // 12-digit UTR
  note           String?      // Project note or message

  status         String       @default("PENDING") // PENDING, APPROVED, DECLINED
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([freelancerId, status])
  @@index([utrNumber])
}
